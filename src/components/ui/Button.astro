---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
  arrow?: boolean;
  id?: string;
}

const { href, variant = 'primary', type = 'button', arrow = variant === 'primary', id } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`]}
  href={href}
  type={href ? undefined : type}
  id={id}
>
  <span class="btn__label"><slot /></span>
  {
    arrow && (
      <span class="btn__arrow" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12h14m0 0-6-6m6 6-6 6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    )
  }
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    text-transform: capitalize;
    text-decoration: none;
    cursor: pointer;
    transition:
      background var(--hover-duration) var(--ease-out),
      border-color var(--hover-duration) var(--ease-out),
      transform var(--hover-duration) var(--ease-out);
  }

  .btn:hover {
    transform: scale(1.02);
  }

  .btn--primary {
    gap: 11px;
    background: var(--purple);
    color: #ffffff;
    padding: 2px 2px 2px 24px;
  }

  .btn--primary:not(:has(.btn__arrow)) {
    padding: 12px 24px;
  }

  .btn__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--purple-deep);
    transition: transform var(--hover-duration) var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(2px);
  }

  .btn--secondary {
    background: rgba(0, 0, 0, 0.08);
    color: #ffffff;
    border-color: var(--hair-dark);
    backdrop-filter: blur(1.5px);
    padding: 12px 24px;
  }

  .btn--secondary:hover {
    border-color: var(--purple-heading);
  }

  .btn--ghost {
    background: transparent;
    color: var(--ink-inverse-2);
    padding: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:hover .btn__arrow {
      transform: none;
    }
  }
</style>
