---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  segments: { text: string; accent?: boolean }[];
  tone?: 'dark' | 'light';
  align?: 'left' | 'center';
  level?: 'h1' | 'h2';
}

const { eyebrow, segments, tone = 'dark', align = 'center', level: Tag = 'h2' } = Astro.props;
---

<div class:list={['sh', `sh--${align}`]} data-reveal>
  <Eyebrow text={eyebrow} tone={tone} align={align} />
  <Tag class:list={['sh__title', `sh__title--${tone}`]}>
    {
      segments.map((seg) => (
        <span class:list={[{ 'sh__accent': seg.accent }]}>{seg.text}{' '}</span>
      ))
    }
  </Tag>
</div>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .sh--center {
    align-items: center;
    text-align: center;
  }

  .sh--left {
    align-items: flex-start;
    text-align: left;
  }

  .sh__title {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.1;
  }

  .sh__title--dark {
    color: var(--ink-inverse);
  }

  .sh__title--light {
    color: var(--ink);
  }

  .sh__accent {
    color: var(--purple-heading);
  }
</style>
