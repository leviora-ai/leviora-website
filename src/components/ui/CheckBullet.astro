---
interface Props {
  text: string;
  tone?: 'light' | 'dark';
}

const { text, tone = 'light' } = Astro.props;
---

<div class:list={['cb', `cb--${tone}`]}>
  <span class="cb__dot" aria-hidden="true"><i></i></span>
  <span class="cb__text">{text}</span>
</div>

<style>
  .cb {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cb__dot {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(221, 213, 233, 0.4);
    border: 1px solid #b7acd4;
    flex-shrink: 0;
  }

  .cb__dot i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #725aa6;
  }

  .cb__text {
    font-weight: 300;
    font-size: 18px;
    line-height: 1.3;
    color: #4a3e6a;
    overflow-wrap: anywhere;
  }

  .cb--dark .cb__text {
    color: var(--ink-inverse);
  }

  .cb--dark .cb__dot {
    background: rgba(78, 47, 144, 0.4);
    border-color: rgba(149, 130, 189, 0.6);
  }

  .cb--dark .cb__dot i {
    background: var(--purple-heading);
  }
</style>
