---
import type { Lang } from '../../../i18n/types';
import { useTranslations } from '../../../i18n/ui';
import SectionHeading from '../../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const n = t.solutions.notFor;
---

<section class="notfor">
  <div class="notfor__inner" data-reveal>
    <SectionHeading eyebrow={n.eyebrow} segments={n.segments} tone="light" />
    <p class="notfor__body">{n.body}</p>
  </div>
</section>

<style>
  .notfor {
    background: var(--bg-light);
  }

  .notfor__inner {
    max-width: 1100px;
    margin-inline: auto;
    padding: var(--section-pad) var(--pad);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    text-align: center;
  }

  .notfor__body {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
