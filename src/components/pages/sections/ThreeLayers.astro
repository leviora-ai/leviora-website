---
import type { Lang } from '../../../i18n/types';
import { useTranslations } from '../../../i18n/ui';
import SectionHeading from '../../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.product.three;
---

<section class="three" id="three-layers">
  <div class="three__inner">
    <div class="three__head" data-reveal>
      <SectionHeading eyebrow={s.eyebrow} segments={s.segments} tone="light" />
      <p class="three__sub">{s.sub}</p>
    </div>

    <div class="three__window" data-reveal>
      <div class="three__bar">
        <span class="three__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="three__brand">Leviora</span>
        <span class="three__live"><i aria-hidden="true"></i>{s.live}</span>
      </div>

      <div class="three__cards" data-reveal-stagger>
        {
          s.cards.map((card) => (
            <div class="tl-card">
              <p class="tl-card__tag">{card.title}</p>
              <p class="tl-card__q">{card.q}</p>
              <div class="tl-card__msg">
                <div class="tl-card__head">
                  <span class="tl-card__avatar">
                    <img src="/assets/leviora-icon.svg" alt="" width="24" height="24" />
                  </span>
                  <span class="tl-card__id">
                    <span class="tl-card__name">
                      {s.aiName}
                      <small>{s.aiTime}</small>
                    </span>
                    <small class="tl-card__meta">{s.aiMeta}</small>
                  </span>
                </div>
                <p class="tl-card__body">{card.body}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="three__input">
        <span class="three__placeholder">{s.placeholder}</span>
        <span class="three__analyze">{s.analyze}</span>
      </div>
    </div>

    <p class="three__closing" data-reveal>{s.closing}</p>
  </div>
</section>

<style>
  .three {
    background: var(--bg-light);
  }

  .three__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--section-pad) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: center;
  }

  .three__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .three__sub {
    margin: 0;
    max-width: 874px;
    text-align: center;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.6;
    color: #777980;
  }

  .three__window {
    width: 100%;
    border-radius: 16px;
    background: #f9f7fd;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(29, 31, 44, 0.08);
  }

  .three__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 24px;
    background: var(--purple);
  }

  .three__dots {
    display: flex;
    gap: 6px;
  }

  .three__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .three__brand {
    font-family: var(--display);
    font-weight: 600;
    font-size: 18px;
    color: #ffffff;
  }

  .three__live {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
  }

  .three__live i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #05df72;
  }

  .three__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 32px 24px;
  }

  .tl-card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
  }

  .tl-card__tag {
    margin: 0;
    padding: 12px;
    text-align: center;
    background: #ecdeff;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.1;
    color: var(--purple);
  }

  .tl-card__q {
    margin: 0;
    padding: 12px 12px 0;
    align-self: flex-end;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.1;
    color: var(--ink-2);
  }

  .tl-card__msg {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
    padding: 12px;
    background: rgba(241, 235, 250, 0.8);
    flex: 1;
  }

  .tl-card__head {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tl-card__avatar {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #e9defa;
    border: 0.8px solid #6a3889;
    flex-shrink: 0;
  }

  .tl-card__id {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .tl-card__name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    color: var(--purple);
  }

  .tl-card__name small {
    font-weight: 300;
    font-size: 14px;
    color: #777980;
  }

  .tl-card__meta {
    font-weight: 300;
    font-size: 12px;
    line-height: 1.3;
    color: #777980;
  }

  .tl-card__body {
    margin: 0;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .three__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 24px 24px;
    padding: 6px 6px 6px 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.32);
    border: 1px solid rgba(29, 31, 44, 0.08);
  }

  .three__placeholder {
    font-weight: 300;
    font-size: 14px;
    color: rgba(74, 62, 106, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .three__analyze {
    padding: 12px 16px;
    border-radius: 8px;
    background: linear-gradient(11.5deg, #4e2f91 0%, #7d499d 71%);
    font-weight: 300;
    font-size: 14px;
    line-height: 1;
    color: #e9e9ea;
    white-space: nowrap;
  }

  .three__closing {
    margin: 0;
    max-width: 738px;
    text-align: center;
    font-weight: 300;
    font-size: 18px;
    line-height: 1.6;
    color: #777980;
  }

  @media (max-width: 1000px) {
    .three__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
