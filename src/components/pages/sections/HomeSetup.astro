---
import type { Lang } from '../../../i18n/types';
import { useTranslations } from '../../../i18n/ui';
import SectionHeading from '../../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.home.setup;
---

<section class="setup" id="setup">
  <div class="setup__inner">
    <SectionHeading eyebrow={s.eyebrow} segments={s.segments} tone="dark" />

    <div class="setup__grid">
      <div class="setup__list" data-setup-list data-reveal>
        {
          s.items.map((item, i) => (
            <button
              class:list={['setup-item', { 'setup-item--active': i === 0 }]}
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
            >
              <span class="setup-item__row">
                <span class="setup-item__title">{item.title}</span>
                <span class="setup-item__tag">{item.tag}</span>
              </span>
              <span class="setup-item__body">{item.body}</span>
            </button>
          ))
        }
      </div>

      <div class="setup__panel" data-reveal>
        <img
          class="setup__photo"
          src="/assets/diagrams/stars-grid.webp"
          alt=""
          loading="lazy"
        />
        <div class="setup__panel-head">
          <p class="setup__panel-title">{s.panel.title}</p>
          <span class="setup__network">{s.panel.network}</span>
        </div>

        <svg class="setup__lines" viewBox="0 0 726 372" fill="none" aria-hidden="true">
          <path class="flow" d="M556 22 C 420 30, 320 120, 240 176"></path>
          <path class="flow" d="M556 94 C 440 100, 340 150, 240 182"></path>
          <path class="flow" d="M556 186 C 460 186, 330 186, 245 186"></path>
          <path class="flow" d="M556 282 C 440 270, 340 220, 240 192"></path>
          <path class="flow" d="M556 354 C 420 340, 320 240, 240 198"></path>
          <circle class="dot dot--1" r="3.5"></circle>
          <circle class="dot dot--2" r="3.5"></circle>
          <circle class="dot dot--3" r="3.5"></circle>
          <circle class="dot dot--4" r="3.5"></circle>
          <circle class="dot dot--5" r="3.5"></circle>
        </svg>

        <div class="setup__center">
          <span class="setup__ring" aria-hidden="true"></span>
          <span class="setup__hub">
            <img src="/assets/leviora-icon.svg" alt="" width="28" height="28" />
          </span>
          <span class="setup__center-label">{s.panel.center}</span>
        </div>

        <div class="setup__chips">
          {s.panel.chips.slice(0, 2).map((c) => <span class="setup-chip">{c}</span>)}
          <span class="setup-chip setup-chip--dashed">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            {s.panel.other}
          </span>
          {s.panel.chips.slice(2).map((c) => <span class="setup-chip">{c}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .setup {
    background: var(--bg-deep);
  }

  .setup__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--section-pad) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .setup__grid {
    display: grid;
    grid-template-columns: 546px 1fr;
    gap: 56px;
    align-items: start;
  }

  /* ---- Left: accordion ---- */
  .setup__list {
    display: flex;
    flex-direction: column;
  }

  .setup-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: transparent;
    border: none;
    border-bottom: 1px solid #262528;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .setup-item__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }

  .setup-item__title {
    font-weight: 300;
    font-size: 24px;
    line-height: 1.2;
    color: #ffffff;
  }

  .setup-item__tag {
    padding: 6px 12px;
    border-radius: 50px;
    background: rgba(42, 39, 46, 0.5);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.1;
    color: #ffffff;
    white-space: nowrap;
  }

  .setup-item__body {
    display: none;
    font-weight: 300;
    font-size: 18px;
    line-height: 1.4;
    color: #d2d2d5;
  }

  .setup-item--active {
    padding: 18px 24px;
    border-radius: 16px 16px 0 0;
    border: 1px solid #6a3889;
    background: linear-gradient(8deg, rgba(78, 47, 145, 0.1) 0%, rgba(125, 73, 157, 0.1) 71%);
  }

  .setup-item--active .setup-item__title {
    font-weight: 400;
  }

  .setup-item--active .setup-item__tag {
    background: linear-gradient(to bottom, rgba(106, 56, 137, 0.2), rgba(98, 42, 133, 0.2));
    border: 1px solid #6a3889;
  }

  .setup-item--active .setup-item__body {
    display: block;
  }

  /* ---- Right: network panel ---- */
  .setup__panel {
    position: relative;
    min-height: 524px;
    border-radius: var(--radius-lg);
    background: #17131f;
    overflow: hidden;
    padding: 28px 32px;
  }

  .setup__photo {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 60%;
    object-fit: cover;
    opacity: 0.35;
    mask-image: linear-gradient(to right, black 40%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 40%, transparent 100%);
  }

  .setup__panel-head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .setup__panel-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.1;
    color: #ffffff;
  }

  .setup__network {
    padding: 12px 24px;
    border-radius: 40px;
    background: #1c222a;
    border: 1px solid #294443;
    font-weight: 300;
    font-size: 16px;
    line-height: 1;
    color: #5dcaa5;
    white-space: nowrap;
  }

  .setup__lines {
    position: absolute;
    inset: 15% 3% 5%;
    width: 94%;
    height: 80%;
    pointer-events: none;
  }

  .flow {
    stroke: rgba(149, 130, 189, 0.35);
    stroke-width: 1.4;
    stroke-dasharray: 6 7;
    animation: setupflow 2.6s linear infinite;
  }

  @keyframes setupflow {
    to {
      stroke-dashoffset: -26;
    }
  }

  /* traveling data dots: chip → hub */
  .dot {
    fill: #b9a7f5;
    filter: drop-shadow(0 0 6px rgba(185, 167, 245, 0.9));
    offset-rotate: 0deg;
    animation: dotflow 3.2s linear infinite;
  }

  .dot--1 {
    offset-path: path('M556 22 C 420 30, 320 120, 240 176');
  }

  .dot--2 {
    offset-path: path('M556 94 C 440 100, 340 150, 240 182');
    animation-delay: 0.6s;
  }

  .dot--3 {
    offset-path: path('M556 186 C 460 186, 330 186, 245 186');
    animation-delay: 1.2s;
  }

  .dot--4 {
    offset-path: path('M556 282 C 440 270, 340 220, 240 192');
    animation-delay: 1.8s;
  }

  .dot--5 {
    offset-path: path('M556 354 C 420 340, 320 240, 240 198');
    animation-delay: 2.4s;
  }

  @keyframes dotflow {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .setup__center {
    position: absolute;
    left: 26%;
    top: 52%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .setup__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100px;
    height: 100px;
    transform: translate(-62%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(149, 130, 189, 0.25);
    animation: ringpulse 4s var(--ease-out) infinite;
  }

  @keyframes ringpulse {
    0%,
    100% {
      transform: translate(-62%, -50%) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: translate(-62%, -50%) scale(1.12);
      opacity: 1;
    }
  }

  .setup__hub {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #3d3c47;
    border: 1px solid #8158a4;
    animation: hubpulse 4s var(--ease-out) infinite;
  }

  .setup__hub::after {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(129, 88, 164, 0.45) 0%, transparent 70%);
    animation: hubglow 4s var(--ease-out) infinite;
  }

  @keyframes hubpulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  @keyframes hubglow {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  .setup__center-label {
    padding: 12px 18px;
    border-radius: 8px;
    background: linear-gradient(6deg, #25183b 0%, #2f1e3e 71%);
    border: 1px solid #6a3889;
    font-weight: 300;
    font-size: 16px;
    line-height: 1;
    color: #e9e9ea;
    white-space: nowrap;
  }

  .setup__chips {
    position: absolute;
    right: 32px;
    top: 112px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 166px;
  }

  .setup-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 12px;
    border-radius: 8px;
    background: #2f1d3d;
    border: 3px solid #38234a;
    font-weight: 300;
    font-size: 16px;
    line-height: 1;
    color: #ffffff;
    white-space: nowrap;
  }

  .setup-chip:first-child {
    border-color: #6a3889;
  }

  .setup-chip--dashed {
    background: #261f33;
    border: 1px dashed rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 1100px) {
    .setup__grid {
      grid-template-columns: 1fr;
    }

    .setup__panel {
      min-height: 560px;
    }
  }

  @media (max-width: 640px) {
    .setup__chips {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
      margin-top: 260px;
    }

    .setup__lines {
      display: none;
    }

    .setup__center {
      left: 50%;
      top: 46%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .setup__ring,
    .setup__hub,
    .setup__hub::after {
      animation: none;
    }

    .dot {
      display: none;
    }
  }
</style>

<script>
  import '../../../scripts/setup-accordion';
</script>
