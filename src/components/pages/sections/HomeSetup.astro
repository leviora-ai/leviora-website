---
import type { Lang } from '../../../i18n/types';
import { useTranslations } from '../../../i18n/ui';
import SectionHeading from '../../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.home.setup;
---

<section class="setup" id="setup">
  <div class="setup__inner">
    <SectionHeading eyebrow={s.eyebrow} segments={s.segments} tone="dark" />

    <div class="setup__grid">
      <div class="setup__list" data-setup-list data-reveal>
        {
          s.items.map((item, i) => (
            <button
              class:list={['setup-item', { 'setup-item--active': i === 0 }]}
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
            >
              <span class="setup-item__row">
                <span class="setup-item__title">{item.title}</span>
              </span>
              <span class="setup-item__body">{item.body}</span>
            </button>
          ))
        }
      </div>

      <div class="setup__panel" data-reveal data-setup-panel data-step="0">
        <img
          class="setup__photo"
          src="/assets/diagrams/stars-grid.webp"
          alt=""
          aria-hidden="true"
          loading="lazy"
        />

        {/* Step 1 — Connect: systems flow into a single center */}
        <div class="setup-view setup-view--connect" aria-hidden="false">
          <div class="setup__panel-head">
            <p class="setup__panel-title">{s.panel.title}</p>
            <span class="setup__network">{s.panel.network}</span>
          </div>

          <svg class="setup__lines" viewBox="0 0 726 372" fill="none" aria-hidden="true">
            <path class="flow" d="M556 22 C 420 30, 320 120, 240 176"></path>
            <path class="flow" d="M556 94 C 440 100, 340 150, 240 182"></path>
            <path class="flow" d="M556 186 C 460 186, 330 186, 245 186"></path>
            <path class="flow" d="M556 282 C 440 270, 340 220, 240 192"></path>
            <path class="flow" d="M556 354 C 420 340, 320 240, 240 198"></path>
            <circle class="dot dot--1" r="3.5"></circle>
            <circle class="dot dot--2" r="3.5"></circle>
            <circle class="dot dot--3" r="3.5"></circle>
            <circle class="dot dot--4" r="3.5"></circle>
            <circle class="dot dot--5" r="3.5"></circle>
          </svg>

          <div class="setup__center">
            <span class="setup__ring" aria-hidden="true"></span>
            <span class="setup__hub" aria-hidden="true">
              <img src="/assets/leviora-icon.svg" alt="" width="28" height="28" />
            </span>
            <span class="setup__center-label">{s.panel.center}</span>
          </div>

          <span class="setup__vline" aria-hidden="true"><i></i></span>

          <div class="setup__chips">
            {s.panel.chips.slice(0, 2).map((c) => <span class="setup-chip">{c}</span>)}
            <span class="setup-chip setup-chip--dashed">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
              {s.panel.other}
            </span>
            {s.panel.chips.slice(2).map((c) => <span class="setup-chip">{c}</span>)}
          </div>
        </div>

        {/* Step 2 — Map: raw tables mapped to business objects */}
        <div class="setup-view setup-view--map" aria-hidden="true">
          <p class="setup__panel-title">{s.mapView.title}</p>
          <div class="mapv">
            {
              s.mapView.pairs.map((p, i) => (
                <div class="mapv__row" style={`--i:${i}`}>
                  <span class="mapv__from">{p.from}</span>
                  <span class="mapv__link" aria-hidden="true">
                    <i class="mapv__dot" />
                  </span>
                  <span class="mapv__to">{p.to}</span>
                </div>
              ))
            }
          </div>
        </div>

        {/* Step 3 — Use: the team just asks */}
        <div class="setup-view setup-view--use" aria-hidden="true">
          <p class="setup__panel-title">{s.useView.title}</p>
          <div class="usev">
            <div class="usev__q">{s.useView.question}</div>
            <div class="usev__a">
              <span class="usev__avatar" aria-hidden="true">
                <img src="/assets/leviora-icon.svg" alt="" width="20" height="20" />
              </span>
              <span class="usev__text">
                <p>{s.useView.answer}</p>
                <small>{s.useView.meta}</small>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .setup {
    background: var(--bg-deep);
  }

  .setup__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--section-pad) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .setup__grid {
    display: grid;
    grid-template-columns: 546px 1fr;
    gap: 56px;
    align-items: start;
  }

  /* ---- Left: accordion ---- */
  .setup__list {
    display: flex;
    flex-direction: column;
  }

  .setup-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: transparent;
    border: none;
    border-bottom: 1px solid #262528;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .setup-item__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }

  .setup-item__title {
    font-weight: 300;
    font-size: 24px;
    line-height: 1.2;
    color: #ffffff;
  }

  .setup-item__body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    font-weight: 300;
    font-size: 18px;
    line-height: 1.4;
    color: #d2d2d5;
    transition:
      max-height 450ms var(--ease-out),
      opacity 350ms var(--ease-out);
  }

  .setup-item--active {
    padding: 18px 24px;
    border-radius: 16px 16px 0 0;
    border: 1px solid #6a3889;
    background: linear-gradient(8deg, rgba(78, 47, 145, 0.1) 0%, rgba(125, 73, 157, 0.1) 71%);
  }

  .setup-item--active .setup-item__title {
    font-weight: 400;
  }

  .setup-item--active .setup-item__body {
    max-height: 240px;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .setup-item__body {
      transition: none;
    }
  }

  /* ---- Right: step-synced diagram panel ---- */
  .setup__panel {
    position: relative;
    min-height: 524px;
    border-radius: var(--radius-lg);
    background: #17131f;
    overflow: hidden;
  }

  .setup-view {
    position: absolute;
    inset: 0;
    padding: 28px 32px;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
    pointer-events: none;
  }

  .setup__panel[data-step='0'] .setup-view--connect,
  .setup__panel[data-step='1'] .setup-view--map,
  .setup__panel[data-step='2'] .setup-view--use {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* ---- Map view ---- */
  .setup-view--map,
  .setup-view--use {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .mapv {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: auto 0;
  }

  .mapv__row {
    display: flex;
    align-items: center;
    gap: 18px;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 350ms var(--ease-out),
      transform 350ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 90ms + 200ms);
  }

  .setup__panel[data-step='1'] .mapv__row {
    opacity: 1;
    transform: none;
  }

  .mapv__from {
    width: 190px;
    padding: 12px 16px;
    border-radius: 8px;
    background: #2f1d3d;
    border: 1px solid #38234a;
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #d2d2d5;
    text-align: center;
    white-space: nowrap;
  }

  .mapv__link {
    position: relative;
    flex: 1;
    height: 1px;
    background-image: linear-gradient(90deg, rgba(149, 130, 189, 0.45) 55%, transparent 45%);
    background-size: 13px 1px;
  }

  .mapv__dot {
    position: absolute;
    top: -3px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b9a7f5;
    box-shadow: 0 0 8px rgba(185, 167, 245, 0.9);
    animation: mapdot 2.6s linear infinite;
    animation-delay: calc(var(--i, 0) * 400ms);
  }

  @keyframes mapdot {
    0% {
      left: 0;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 7px);
      opacity: 0;
    }
  }

  .mapv__to {
    width: 150px;
    padding: 12px 16px;
    border-radius: 8px;
    background: rgba(78, 47, 144, 0.3);
    border: 1px solid #6a3889;
    font-size: 15px;
    color: #ffffff;
    text-align: center;
    white-space: nowrap;
  }

  /* ---- Use view ---- */
  .usev {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: auto 0;
    max-width: 520px;
    align-self: center;
    width: 100%;
  }

  .usev__q,
  .usev__a {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .setup__panel[data-step='2'] .usev__q {
    opacity: 1;
    transform: none;
    transition-delay: 250ms;
  }

  .setup__panel[data-step='2'] .usev__a {
    opacity: 1;
    transform: none;
    transition-delay: 750ms;
  }

  .usev__q {
    align-self: flex-end;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-weight: 300;
    font-size: 16px;
    color: var(--ink-inverse);
  }

  .usev__a {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 12px;
    background: rgba(78, 47, 144, 0.22);
    border: 1px solid rgba(106, 56, 137, 0.6);
  }

  .usev__avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: rgba(233, 222, 250, 0.1);
    border: 0.8px solid rgba(149, 130, 189, 0.5);
    flex-shrink: 0;
  }

  .usev__text p {
    margin: 0 0 6px;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-inverse);
  }

  .usev__text small {
    font-weight: 300;
    font-size: 13px;
    color: var(--purple-heading);
  }

  .setup__photo {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 60%;
    object-fit: cover;
    opacity: 0.35;
    mask-image: linear-gradient(to right, black 40%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 40%, transparent 100%);
  }

  .setup__panel-head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .setup__panel-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.1;
    color: #ffffff;
  }

  .setup__network {
    padding: 12px 24px;
    border-radius: 40px;
    background: #1c222a;
    border: 1px solid #294443;
    font-weight: 300;
    font-size: 16px;
    line-height: 1;
    color: #5dcaa5;
    white-space: nowrap;
  }

  .setup__lines {
    position: absolute;
    inset: 15% 3% 5%;
    width: 94%;
    height: 80%;
    pointer-events: none;
  }

  .flow {
    stroke: rgba(149, 130, 189, 0.35);
    stroke-width: 1.4;
    stroke-dasharray: 6 7;
    animation: setupflow 2.6s linear infinite;
  }

  @keyframes setupflow {
    to {
      stroke-dashoffset: -26;
    }
  }

  /* traveling data dots: chip → hub */
  .dot {
    fill: #b9a7f5;
    filter: drop-shadow(0 0 6px rgba(185, 167, 245, 0.9));
    offset-rotate: 0deg;
    animation: dotflow 3.2s linear infinite;
  }

  .dot--1 {
    offset-path: path('M556 22 C 420 30, 320 120, 240 176');
  }

  .dot--2 {
    offset-path: path('M556 94 C 440 100, 340 150, 240 182');
    animation-delay: 0.6s;
  }

  .dot--3 {
    offset-path: path('M556 186 C 460 186, 330 186, 245 186');
    animation-delay: 1.2s;
  }

  .dot--4 {
    offset-path: path('M556 282 C 440 270, 340 220, 240 192');
    animation-delay: 1.8s;
  }

  .dot--5 {
    offset-path: path('M556 354 C 420 340, 320 240, 240 198');
    animation-delay: 2.4s;
  }

  @keyframes dotflow {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .setup__center {
    position: absolute;
    left: 26%;
    top: 52%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .setup__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100px;
    height: 100px;
    transform: translate(-62%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(149, 130, 189, 0.25);
    animation: ringpulse 4s var(--ease-out) infinite;
  }

  @keyframes ringpulse {
    0%,
    100% {
      transform: translate(-62%, -50%) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: translate(-62%, -50%) scale(1.12);
      opacity: 1;
    }
  }

  .setup__hub {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #3d3c47;
    border: 1px solid #8158a4;
    animation: hubpulse 4s var(--ease-out) infinite;
  }

  .setup__hub::after {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(129, 88, 164, 0.45) 0%, transparent 70%);
    animation: hubglow 4s var(--ease-out) infinite;
  }

  @keyframes hubpulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  @keyframes hubglow {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  .setup__center-label {
    padding: 12px 18px;
    border-radius: 8px;
    background: linear-gradient(6deg, #25183b 0%, #2f1e3e 71%);
    border: 1px solid #6a3889;
    font-weight: 300;
    font-size: 16px;
    line-height: 1;
    color: #e9e9ea;
    white-space: nowrap;
  }

  .setup__chips {
    position: absolute;
    right: 32px;
    top: 112px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 166px;
  }

  .setup-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 12px;
    border-radius: 8px;
    background: #2f1d3d;
    border: 3px solid #38234a;
    font-weight: 300;
    font-size: 16px;
    line-height: 1;
    color: #ffffff;
    white-space: nowrap;
  }

  .setup-chip:first-child {
    border-color: #6a3889;
  }

  .setup-chip--dashed {
    background: #261f33;
    border: 1px dashed rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 1100px) {
    .setup__grid {
      grid-template-columns: 1fr;
    }

    .setup__panel {
      min-height: 560px;
    }
  }

  /* Vertical hub→chips connector, mobile only */
  .setup__vline {
    display: none;
  }

  @media (max-width: 700px) {
    .setup__panel {
      min-height: 0;
    }

    .setup-view {
      position: relative;
      inset: auto;
      padding: 22px 18px 26px;
    }

    .setup-view[aria-hidden='true'] {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    /* Connect view: clean vertical flow */
    .setup-view--connect {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .setup__panel-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .setup__lines {
      display: none;
    }

    .setup__center {
      position: static;
      transform: none;
      align-self: center;
      flex-direction: column;
      gap: 10px;
      margin-top: 10px;
    }

    .setup__ring {
      display: none;
    }

    .setup__vline {
      display: block;
      position: relative;
      align-self: center;
      width: 1px;
      height: 56px;
      background-image: linear-gradient(to bottom, rgba(210, 200, 235, 0.45) 55%, transparent 45%);
      background-size: 1px 12px;
    }

    .setup__vline i {
      position: absolute;
      left: -3px;
      top: 0;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #b9a7f5;
      box-shadow: 0 0 8px rgba(185, 167, 245, 0.9);
      animation: vlinedot 2.2s linear infinite;
    }

    @keyframes vlinedot {
      0% {
        top: 0;
        opacity: 0;
      }
      15% {
        opacity: 1;
      }
      85% {
        opacity: 1;
      }
      100% {
        top: calc(100% - 7px);
        opacity: 0;
      }
    }

    .setup__chips {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      width: 100%;
    }

    .setup__chips .setup-chip--dashed {
      grid-column: 1 / -1;
    }

    .mapv__from {
      width: auto;
      flex: 1;
      font-size: 12px;
      padding: 10px 8px;
    }

    .mapv__to {
      width: auto;
      min-width: 84px;
      font-size: 13px;
      padding: 10px 8px;
    }

    .mapv__link {
      min-width: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .setup__ring,
    .setup__hub,
    .setup__hub::after,
    .mapv__dot,
    .setup__vline i {
      animation: none;
    }

    .dot {
      display: none;
    }

    .setup-view,
    .mapv__row,
    .usev__q,
    .usev__a {
      transition: none;
    }
  }
</style>

<script>
  import '../../../scripts/setup-accordion';
</script>
