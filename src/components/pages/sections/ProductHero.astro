---
import '@fontsource/exo/latin-400.css';
import type { Lang } from '../../../i18n/types';
import { useTranslations, localizePath } from '../../../i18n/ui';
import Eyebrow from '../../ui/Eyebrow.astro';
import Button from '../../ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.product.hero;
---

<section class="phero">
  <div class="phero__inner">
    <div class="phero__head" data-reveal-stagger>
      <Eyebrow text={h.eyebrow} />
      <h1 class="phero__title">
        <span>{h.titleLine1}</span>
        <span class="phero__title-accent">{h.titleLine2}</span>
      </h1>
      <p class="phero__sub">{h.sub}</p>
      <div class="phero__ctas">
        <Button href={localizePath('/contact/', lang)}>{h.ctaPrimary}</Button>
        <Button href="#three-layers" variant="secondary">{h.ctaSecondary}</Button>
      </div>
    </div>

    <div class="phero__diagram" data-reveal>
      <div class="phero__conclusion layer-card layer-card--conclusion">
        <div class="layer-card__text">
          <p class="layer-card__title">{h.conclusion.title}</p>
          <p class="layer-card__body">{h.conclusion.body}</p>
        </div>
      </div>

      <img
        class="phero__diamond"
        src="/assets/diagrams/product-diamond.webp"
        alt={h.diagramAlt}
        width="240"
        height="412"
        loading="lazy"
      />

      <div class="phero__layers">
        {
          h.layers.map((layer, i) => (
            <div class="layer-card">
              <span class="layer-card__pill">
                <b>{String(i + 1).padStart(2, '0')}</b>
                <i>/03</i>
              </span>
              <div class="layer-card__text">
                <p class="layer-card__title">
                  {layer.title}
                  <span class="layer-card__q">{layer.q}</span>
                </p>
                <p class="layer-card__body">{layer.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .phero {
    background:
      url('/assets/diagrams/stars-grid.webp') center bottom / 100% auto no-repeat,
      #0d0a1a;
  }

  .phero__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(56px, 9vw, 120px) var(--pad) clamp(48px, 6vw, 80px);
  }

  .phero__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .phero__title {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1.1;
    color: var(--ink-inverse);
  }

  .phero__title-accent {
    color: var(--purple-heading);
  }

  .phero__sub {
    margin: 0;
    max-width: 896px;
    font-weight: 300;
    font-size: 18px;
    line-height: 1.6;
    color: #e9e9ea;
  }

  .phero__ctas {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---- Diagram ---- */
  .phero__diagram {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(24px, 4vw, 72px);
    align-items: center;
    margin-top: clamp(48px, 6vw, 96px);
  }

  .phero__diamond {
    width: 240px;
    height: auto;
    justify-self: center;
    animation: diamondfloat 9s var(--ease-out) infinite;
  }

  @keyframes diamondfloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  .phero__layers {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .layer-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 18px;
    border-radius: 16px;
    border-left: 1px solid #8158a4;
    background: linear-gradient(to bottom, rgba(40, 28, 78, 0.5), #120c22);
    max-width: 516px;
  }

  .layer-card--conclusion {
    background: linear-gradient(to bottom, rgba(40, 28, 78, 0.6), rgba(18, 12, 34, 0.8));
    justify-self: end;
  }

  .layer-card__pill {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    align-self: flex-start;
    padding: 7px 11px;
    border-radius: 50px;
    border: 1px solid #4e2f91;
    background: linear-gradient(to bottom, rgba(98, 42, 133, 0.1), rgba(106, 56, 137, 0.35));
    font-weight: 300;
    font-size: 14px;
    line-height: 1.16;
    color: #ffffff;
  }

  .layer-card__pill b {
    font-weight: 300;
    font-size: 14px;
    line-height: 1.1;
  }

  .layer-card__pill i {
    font-style: normal;
    font-size: 10px;
    color: #777980;
  }

  .layer-card__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .layer-card__title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.1;
    color: #ffffff;
  }

  .layer-card__q {
    font-size: 14px;
    color: var(--purple-heading);
  }

  .layer-card__body {
    margin: 0;
    font-family: 'Exo', var(--sans);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.3;
    color: rgba(225, 219, 242, 0.72);
  }

  .layer-card--conclusion .layer-card__title {
    font-weight: 500;
  }

  .layer-card--conclusion .layer-card__body {
    font-size: 16px;
    line-height: 1.4;
  }

  @media (max-width: 1000px) {
    .phero__diagram {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .layer-card,
    .layer-card--conclusion {
      justify-self: stretch;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phero__diamond {
      animation: none;
    }
  }
</style>
