---
import type { Lang } from '../../../i18n/types';
import { useTranslations, localizePath } from '../../../i18n/ui';
import Eyebrow from '../../ui/Eyebrow.astro';
import Button from '../../ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.home.statement;
---

<section class="statement" data-statement>
  <div class="statement__bg">
    <img
      src="/assets/diagrams/industry-collage.webp"
      alt={s.collageAlt}
      width="1920"
      height="1080"
      loading="lazy"
      data-statement-bg
    />
  </div>
  <div class="statement__content" data-reveal-stagger>
    <Eyebrow text={s.eyebrow} />
    <h2 class="statement__title">
      <span>{s.titleLine1}</span>
      <span class="statement__title-accent">{s.titleLine2}</span>
    </h2>
    <ul class="statement__industries">
      {s.industries.map((name) => <li>{name}</li>)}
    </ul>
    <Button href={localizePath('/contact/', lang)}>{s.cta}</Button>
  </div>
</section>

<style>
  .statement {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(480px, 44vw, 698px);
    padding: var(--section-pad) var(--pad);
    background: var(--bg-deep);
    overflow: hidden;
  }

  .statement__bg {
    position: absolute;
    inset: 0;
  }

  .statement__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(14, 11, 22, 0.72) 0%,
      rgba(14, 11, 22, 0.58) 53%,
      rgba(14, 11, 22, 0.72) 100%
    );
  }

  .statement__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.32);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .statement__bg img {
      transform: none;
      will-change: auto;
    }
  }

  .statement__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
    max-width: 1000px;
  }

  .statement__title {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.1;
    color: var(--ink-inverse);
  }

  .statement__title-accent {
    color: var(--purple-heading);
  }

  .statement__industries {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 760px;
  }

  .statement__industries li {
    padding: 8px 16px;
    border-radius: 50px;
    border: 1px solid rgba(129, 88, 164, 0.55);
    background: rgba(18, 12, 38, 0.55);
    font-weight: 300;
    font-size: 14px;
    line-height: 1.3;
    color: #e9e9ea;
  }
</style>

<script>
  import '../../../scripts/statement-zoom';
</script>
