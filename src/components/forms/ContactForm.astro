---
import type { Lang } from '../../i18n/types';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.contact.form;
---

<form class="cform" method="post" action="/api/contact" data-contact-form data-lang={lang}>
  <h2 class="cform__title">{f.title}</h2>
  <p class="cform__note">{f.note}</p>

  <div class="cform__grid">
    <label class="cform__field">
      <span>{f.name}</span>
      <input type="text" name="name" placeholder={f.namePlaceholder} autocomplete="name" />
    </label>
    <label class="cform__field">
      <span>{f.phone}</span>
      <input type="tel" name="phone" placeholder={f.phonePlaceholder} autocomplete="tel" />
    </label>
    <label class="cform__field">
      <span>{f.email}</span>
      <input
        type="email"
        name="email"
        placeholder={f.emailPlaceholder}
        autocomplete="email"
        required
      />
    </label>
    <label class="cform__field">
      <span>{f.company}</span>
      <input
        type="text"
        name="company"
        placeholder={f.companyPlaceholder}
        autocomplete="organization"
        required
      />
    </label>
  </div>

  <label class="cform__field cform__field--full">
    <span>{f.message}</span>
    <textarea name="message" rows="3" placeholder={f.messagePlaceholder}></textarea>
  </label>

  {/* honeypot — bots fill it, humans never see it */}
  <label class="cform__hp" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <button class="cform__submit" type="submit" data-label={f.submit} data-sending={f.sending}>
    {f.submit}
    <span class="cform__arrow" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 12h14m0 0-6-6m6 6-6 6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>

  <p class="cform__status" data-status data-success={f.success} data-error={f.error} role="status"></p>
</form>

<style>
  .cform {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: #131018;
    border: 1px solid var(--hair-dark);
  }

  .cform__title {
    margin: 0;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.2;
    color: #ffffff;
  }

  .cform__note {
    margin: -8px 0 0;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.5;
    color: #d2d2d5;
  }

  .cform__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cform__field--full {
    width: 100%;
  }

  .cform__field span {
    font-weight: 400;
    font-size: 15px;
    color: var(--ink-inverse);
  }

  .cform__field input,
  .cform__field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    padding: 8px 2px 10px;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 15px;
    color: var(--ink-inverse);
    transition: border-color var(--hover-duration) var(--ease-out);
  }

  .cform__field input::placeholder,
  .cform__field textarea::placeholder {
    color: var(--ink-inverse-3);
  }

  .cform__field input:focus-visible,
  .cform__field textarea:focus-visible {
    outline: none;
    border-bottom-color: var(--purple-heading);
  }

  .cform__field textarea {
    resize: vertical;
    min-height: 64px;
  }

  .cform__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cform__submit {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    align-self: flex-start;
    padding: 12px 24px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--purple);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.4;
    color: #ffffff;
    cursor: pointer;
    transition:
      background var(--hover-duration) var(--ease-out),
      transform var(--hover-duration) var(--ease-out);
  }

  .cform__submit:hover {
    transform: scale(1.02);
  }

  .cform__submit:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .cform__status {
    margin: 0;
    min-height: 1.4em;
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-inverse-2);
  }

  .cform__status.ok {
    color: #5dcaa5;
  }

  .cform__status.err {
    color: #e2707a;
  }

  @media (max-width: 640px) {
    .cform__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cform__submit:hover {
      transform: none;
    }
  }
</style>

<script>
  import '../../scripts/contact-form';
</script>
