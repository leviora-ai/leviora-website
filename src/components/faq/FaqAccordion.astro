---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  items: { q: string; a: string }[];
  eyebrow: string;
  segments: { text: string; accent?: boolean }[];
}

const { items, eyebrow, segments } = Astro.props;
---

<section class="faq" id="faq">
  <div class="faq__inner">
    <SectionHeading eyebrow={eyebrow} segments={segments} tone="light" />
    <div class="faq__list" data-faq data-reveal-stagger>
      {
        items.map((item, i) => (
          <details class="qa" open={i === 0}>
            <summary class="qa__q">
              <span>{i + 1}. {item.q}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <p class="qa__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg-light);
  }

  .faq__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--section-pad) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
  }

  .qa {
    border-bottom: 1px solid var(--hair-light);
    padding: 22px 0;
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    list-style: none;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    color: var(--ink);
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--ink-2);
    transition: transform var(--hover-duration) var(--ease-out);
  }

  .qa__icon::before {
    width: 16px;
    height: 1.6px;
  }

  .qa__icon::after {
    width: 1.6px;
    height: 16px;
  }

  .qa[open] .qa__icon::after {
    transform: scaleY(0);
  }

  .qa__a {
    margin: 12px 0 0;
    max-width: 1200px;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-3);
  }
</style>

<script>
  import '../../scripts/faq';
</script>
