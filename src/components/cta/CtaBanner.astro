---
import type { Lang } from '../../i18n/types';
import { useTranslations, localizePath } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cta = t.cta;
---

<section class="ctab">
  <div class="ctab__inner">
    <div class="ctab__card" data-reveal>
      <div class="ctab__content">
        <SectionHeading eyebrow={cta.eyebrow} segments={cta.segments} tone="dark" />
        <p class="ctab__sub">{cta.sub}</p>
        <div class="ctab__buttons">
          <Button href={localizePath('/contact/', lang)}>{cta.primary}</Button>
          <Button href={localizePath('/product/', lang)} variant="secondary">
            {cta.secondary}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ctab {
    background: var(--bg-deep);
  }

  .ctab__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--section-pad) var(--pad);
  }

  .ctab__card {
    position: relative;
    border-radius: var(--radius-lg);
    background:
      url('/assets/diagrams/stars-grid.webp') left center / auto 115% no-repeat,
      url('/assets/diagrams/stars-grid.webp') right center / auto 115% no-repeat,
      #06050a;
    overflow: hidden;
    padding: clamp(48px, 6vw, 80px) var(--pad);
  }

  .ctab__card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 90% at 50% 50%, transparent 30%, rgba(6, 5, 10, 0.55) 100%);
  }

  .ctab__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .ctab__sub {
    margin: 0;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.6;
    color: #e9e9ea;
  }

  .ctab__buttons {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
