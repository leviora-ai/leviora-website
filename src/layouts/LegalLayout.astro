---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/types';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  heading: string;
  updated?: string;
}

const { lang, title, description, path, heading, updated } = Astro.props;
---

<BaseLayout lang={lang} title={title} description={description} path={path}>
  <article class="legal">
    <h1>{heading}</h1>
    {updated && <p class="legal__updated">{updated}</p>}
    <div class="legal__body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: 760px;
    margin-inline: auto;
    padding: clamp(48px, 8vw, 96px) var(--pad) var(--section-pad);
  }

  .legal h1 {
    font-size: clamp(32px, 4vw, 44px);
    margin: 0 0 8px;
  }

  .legal__updated {
    color: var(--ink-inverse-3);
    font-size: 14px;
    margin: 0 0 40px;
  }

  .legal__body {
    color: var(--ink-inverse-2);
    line-height: 1.75;
    font-size: 16px;
  }

  .legal__body :global(h2) {
    color: var(--ink-inverse);
    font-size: 22px;
    margin: 40px 0 12px;
  }

  .legal__body :global(p) {
    margin: 0 0 16px;
  }
</style>
