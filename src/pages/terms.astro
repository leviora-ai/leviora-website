---
import LegalLayout from '../layouts/LegalLayout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('en');
---

<LegalLayout
  lang="en"
  title={t.meta.terms.title}
  description={t.meta.terms.description}
  path="/terms/"
  heading="Terms & Conditions"
  updated="Last updated: July 2026"
>
  <p>
    These terms govern your use of the leviora.ai website. By using the site, you accept
    them.
  </p>

  <h2>Content</h2>
  <p>
    The content on this site is provided for general information about the Leviora platform.
    It does not constitute a contractual offer. Product capabilities, packages and timelines
    are finalized in a written agreement.
  </p>

  <h2>Intellectual property</h2>
  <p>
    The Leviora name, logo, and all content on this site belong to Leviora and may not be
    reproduced without permission.
  </p>

  <h2>Liability</h2>
  <p>
    The site is provided "as is". We strive for accuracy but do not guarantee that all
    information is complete or current, and we accept no liability for decisions made based
    on site content.
  </p>

  <h2>Changes</h2>
  <p>
    We may update these terms from time to time. The current version is always available on
    this page.
  </p>

  <h2>Contact</h2>
  <p>Leviora — <a href="mailto:info@leviora.ai">info@leviora.ai</a></p>
</LegalLayout>
