---
import LegalLayout from '../layouts/LegalLayout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('en');
---

<LegalLayout
  lang="en"
  title={t.meta.privacy.title}
  description={t.meta.privacy.description}
  path="/privacy/"
  heading="Privacy Policy"
  updated="Last updated: July 2026"
>
  <p>
    This policy explains how Leviora ("we") handles personal information collected through
    leviora.ai. We keep it short because we collect very little.
  </p>

  <h2>What we collect</h2>
  <p>
    When you submit the demo request form, we receive the information you provide: your name,
    email address, phone number, company name and your message. The website does not use
    advertising trackers and does not set marketing cookies.
  </p>

  <h2>How we use it</h2>
  <p>
    Form submissions are delivered to our inbox (info@leviora.ai) via our email delivery
    provider and are used solely to respond to your request and plan a demo or pilot. We do
    not sell or share your information with third parties for marketing.
  </p>

  <h2>Retention</h2>
  <p>
    We keep correspondence for as long as needed to handle your request and our business
    relationship, after which it is deleted.
  </p>

  <h2>Your rights</h2>
  <p>
    You may request access to, correction of, or deletion of your personal data at any time
    by writing to <a href="mailto:info@leviora.ai">info@leviora.ai</a>. Residents of Türkiye
    also have the rights set out in our <a href="/kvkk/">KVKK notice</a>.
  </p>

  <h2>Contact</h2>
  <p>Leviora — <a href="mailto:info@leviora.ai">info@leviora.ai</a></p>
</LegalLayout>
